
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>My iPhone</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#17171c;color:white;font-family:-apple-system,BlinkMacSystemFont,sans-serif}
button,input{font:inherit}
button{cursor:pointer}
.phone{position:relative;width:min(390px,100%);height:100dvh;max-height:850px;min-height:600px;margin:auto;background:#101522;overflow:hidden}
.status{height:45px;padding:12px 25px;display:flex;justify-content:space-between;font-size:13px;font-weight:bold;position:absolute;top:0;width:100%;z-index:5}
.island{position:absolute;top:10px;left:50%;transform:translateX(-50%);width:100px;height:28px;background:#000;border-radius:30px;z-index:6}
.screen{position:absolute;inset:0;padding-top:48px;transition:opacity .25s,transform .25s;overflow:hidden}
.screen[hidden]{display:none}
.wallpaper{background:radial-gradient(ellipse at 25% 30%,#ffb6c8,transparent 38%),radial-gradient(ellipse at 80% 45%,#8174f0,transparent 40%),linear-gradient(145deg,#203e74,#17122e 70%,#101020)}
.lock{text-align:center;padding-top:115px}
.date{font-size:17px}
.clock{font-size:85px;font-weight:200;letter-spacing:-5px}
.notice{margin:45px 18px 0;text-align:left;padding:15px;background:#ffffff2b;backdrop-filter:blur(20px);border-radius:18px}
.notice button{color:white;background:none;border:0;text-align:left;width:100%}
.bottom{position:absolute;bottom:28px;left:25px;right:25px;display:flex;justify-content:space-between}
.round{width:46px;height:46px;border:0;border-radius:50%;background:#ffffff35;color:white}
.bar{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:115px;height:5px;border-radius:8px;background:white}
.home{padding:75px 20px 80px}
.greeting{text-align:center;margin-bottom:35px;font-size:14px}
.apps{display:grid;grid-template-columns:repeat(4,1fr);gap:27px 8px}
.app{display:flex;flex-direction:column;align-items:center;gap:6px;background:none;border:0;color:white;font-size:11px}
.icon{height:54px;width:54px;border-radius:15px;display:grid;place-items:center;font-size:29px;background:#777;box-shadow:0 3px 10px #0002}
.green{background:#35c759}.blue{background:#087cff}.pink{background:#ff6685}.orange{background:#ff9636}.purple{background:#9670e8}
.dock{position:absolute;bottom:28px;left:12px;right:12px;border-radius:24px;background:#ffffff35;backdrop-filter:blur(18px);padding:12px;display:flex;justify-content:space-around}
.page{background:#f2f2f7;color:#202024}
.nav{height:48px;background:#fafafc;display:flex;align-items:center;justify-content:space-between;padding:0 15px;border-bottom:1px solid #ddd}
.nav button{border:0;background:none;color:#087cff}
.content{height:calc(100% - 120px);overflow:auto;padding:18px 15px 30px}
.card{background:white;border-radius:15px;padding:15px;margin-bottom:12px}
.muted{color:#888;font-size:13px}
.person{display:flex;align-items:center;gap:12px;background:white;border-radius:15px;padding:12px}
.avatar{width:43px;height:43px;display:grid;place-items:center;background:#ddd;border-radius:50%;font-size:23px}
.bubble{width:fit-content;max-width:85%;padding:11px 14px;border-radius:19px;margin:10px 0;background:#e3e3e8;white-space:pre-wrap;overflow-wrap:anywhere}
.out{margin-left:auto;background:#1685fa;color:white}
.chatform{position:absolute;bottom:25px;left:12px;right:12px;display:flex;gap:7px}
.chatform input{min-width:0;flex:1;border:1px solid #ddd;border-radius:22px;padding:11px;background:white;color:#222}
.send{border:0;background:#087cff;color:white;border-radius:50%;width:42px}
.photos{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}
.photos img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px}
.photo{border:0;padding:0;background:#ddd}
.secret{width:100%;padding:16px;border:0;border-radius:13px;text-align:left;background:#e4e4eb;color:#222}
.secret.open{background:#dff8e5}
.keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:270px;margin:25px auto}
.keypad button{height:55px;border:0;border-radius:50%;background:#dedee5;color:#222;font-size:22px}
.dots{font-size:25px;letter-spacing:8px}
.call{text-align:center;background:linear-gradient(#424451,#13141a);padding-top:120px}
.caller{font-size:60px;width:110px;height:110px;display:grid;place-items:center;background:#777;border-radius:50%;margin:25px auto}
.callbuttons{position:absolute;bottom:100px;left:40px;right:40px;display:flex;justify-content:space-between}
.callbuttons button{height:65px;width:65px;border:0;border-radius:50%;font-size:25px;color:white}
.red{background:#ff3b30}.answer{background:#34c759}
.error{color:#e34b5b;font-size:13px;min-height:22px}
</style>
</head>
<body>
<div class="phone">
<div class="island"></div>
<div class="status"><span id="time">9:41</span><span>● ▰ 5G ▰</span></div>

<section class="screen wallpaper lock" id="lock">
<div class="date" id="date">10월 19일 월요일</div>
<div class="clock" id="clock">9:41</div>
<div class="notice"><button data-page="messages">💬 메시지 · 지금<br><br><b>새로운 메시지가 도착했습니다.</b><br><br>눌러서 확인하기</button></div>
<div class="bottom"><button class="round" data-page="call">🔦</button><button class="round" data-page="pass">🔓</button></div>
<div class="bar"></div>
</section>

<section class="screen wallpaper home" id="home" hidden>
<div class="greeting" id="greeting">오늘도 좋은 하루</div>
<div class="apps">
<button class="app" data-page="call"><span class="icon green">📞</span>전화</button>
<button class="app" data-page="messages"><span class="icon green">💬</span>메시지</button>
<button class="app" data-page="photos"><span class="icon pink">🌸</span>사진</button>
<button class="app" data-page="secret"><span class="icon gray">📝</span>메모</button>
<button class="app" data-page="pass"><span class="icon purple">🔒</span>비밀 폴더</button>
<button class="app" data-page="secret"><span class="icon orange">💌</span>편지</button>
<button class="app" data-page="call"><span class="icon blue">☎️</span>전화 수신</button>
<button class="app" data-page="photos"><span class="icon gray">🖼️</span>앨범</button>
</div>
<div class="dock">
<button class="app" data-page="call"><span class="icon green">📞</span></button>
<button class="app" data-page="messages"><span class="icon green">💬</span></button>
<button class="app" data-page="photos"><span class="icon pink">🌸</span></button>
</div><div class="bar"></div>
</section>

<section class="screen page" id="messages" hidden>
<div class="nav"><button data-page="home">‹ 홈</button><b>메시지</b><button data-page="secret">편집</button></div>
<div class="content" id="chat">
<div class="person"><div class="avatar">👤</div><div><b id="name">차주한</b><div class="muted">메시지</div></div></div>
<p class="muted" style="text-align:center;margin-top:25px">오늘</p>
<div class="bubble">뭐 해?</div>
<div class="bubble">나한테 할 말 있잖아.</div>
<div class="bubble out">무슨 말?</div>
<div class="bubble">직접 확인해 봐.</div>
<div class="bubble out">어디서?</div>
<div class="bubble">아래에 있는 메시지.</div>
</div>
<form class="chatform" id="chatform"><input id="message" placeholder="iMessage" autocomplete="off"><button class="send">↑</button></form>
<div class="bar" style="background:#222"></div>
</section>

<section class="screen page" id="photos" hidden>
<div class="nav"><button data-page="home">‹ 홈</button><b>사진</b><button id="closePhotos">닫기</button></div>
<div class="content"><h2>최근 항목</h2><p class="muted">사진을 누르면 크게 볼 수 있어.</p>
<div class="photos" id="photoGrid"></div>
<div class="card" style="margin-top:15px"><b>내 사진 추가하기</b><p class="muted">사진을 선택하면 앨범에 추가돼.</p><input id="upload" type="file" accept="image/*" multiple></div>
</div><div class="bar" style="background:#222"></div>
</section>

<section class="screen page" id="secret" hidden>
<div class="nav"><button data-page="home">‹ 홈</button><b>메모</b><button data-page="pass">잠금</button></div>
<div class="content"><h2>나만의 메모</h2><p class="muted">버튼을 눌러 숨겨진 메시지를 확인해.</p>
<button class="secret" id="reveal">🔒 잠긴 메시지<p>눌러서 확인하기</p></button>
<div class="card" style="margin-top:18px"><b>비밀 메시지</b><p id="secretText" hidden>사실은 너에게 꼭 전하고 싶은 말이 있었어. 💌</p><button id="reveal2" style="background:#087cff;color:white;border:0;padding:12px;border-radius:10px;width:100%">메시지 공개하기</button></div>
</div><div class="bar" style="background:#222"></div>
</section>

<section class="screen page" id="pass" hidden>
<div class="nav"><button data-page="home">취소</button><b>비밀 폴더</b><button data-page="home">닫기</button></div>
<div class="content" style="text-align:center;padding-top:40px">
<div style="font-size:45px">🔒</div><h2>암호 입력</h2><p class="muted">비밀 폴더를 열려면 암호를 입력하세요.</p>
<div class="dots" id="dots">○ ○ ○ ○</div><div class="error" id="error"></div>
<div class="keypad" id="keypad">
<button data-key="1">1</button><button data-key="2">2</button><button data-key="3">3</button>
<button data-key="4">4</button><button data-key="5">5</button><button data-key="6">6</button>
<button data-key="7">7</button><button data-key="8">8</button><button data-key="9">9</button>
<button data-key="clear">⌫</button><button data-key="0">0</button><button data-key="enter">↵</button>
</div><p class="muted">데모 암호: 1234</p>
</div><div class="bar" style="background:#222"></div>
</section>

<section class="screen call" id="call" hidden>
<div style="color:#ddd">수신 전화</div><div class="caller">👤</div>
<h2 id="caller">차주한</h2><p style="color:#ddd">휴대전화</p>
<div class="callbuttons"><div><button class="red" id="decline">✕</button><p>거절</p></div><div><button class="answer" id="answer">☎</button><p>응답</p></div></div>
<div class="bar"></div>
</section>

<section class="screen call" id="incall" hidden>
<div style="color:#ddd">통화 중</div><div class="caller">👤</div><h2 id="callingName">차주한</h2>
<p id="duration">00:00</p><button class="red" id="end" style="border:0;border-radius:50%;width:65px;height:65px;font-size:25px;position:absolute;bottom:100px;left:calc(50% - 32px)">✕</button><div class="bar"></div>
</section>
</div>

<script>
const $=id=>document.getElementById(id);
let current="lock",code="",secs=0,timer;
function go(id){
  if(!$ (id))return;
  document.querySelectorAll(".screen").forEach(s=>{
    s.hidden=s.id!==id;
    s.style.opacity="0";
    s.style.transform="translateX(10px)";
  });
  current=id;
  const s=$(id);
  requestAnimationFrame(()=>{s.style.opacity="1";s.style.transform="translateX(0)"});
  $("photoView")?.remove();
  if(id==="pass"){code="";dots()}
}
document.querySelectorAll("[data-page]").forEach(b=>b.onclick=()=>go(b.dataset.page));

function clock(){
 const d=new Date(),t=d.toLocaleTimeString("ko-KR",{hour:"2-digit",minute:"2-digit",hour12:false});
 $("time").textContent=t;$("clock").textContent=t;
 $("date").textContent=d.toLocaleDateString("ko-KR",{month:"long",day:"numeric",weekday:"long"});
 $("greeting").textContent=$("date").textContent;
}
clock();setInterval(clock,15000);

$("chatform").onsubmit=e=>{
 e.preventDefault();let v=$("message").value.trim();if(!v)return;
 const b=document.createElement("div");b.className="bubble out";b.textContent=v;
 $("chat").appendChild(b);$("message").value="";$("chat").scrollTop=$("chat").scrollHeight;
};

function reveal(){
 $("secretText").hidden=false;
 $("reveal").classList.add("open");
 $("reveal").textContent="🔓 메시지가 열렸습니다";
}
$("reveal").onclick=reveal;$("reveal2").onclick=reveal;

function dots(){$("dots").textContent=Array.from({length:4},(_,i)=>i<code.length?"●":"○").join(" ")}
$("keypad").onclick=e=>{
 const b=e.target.closest("[data-key]");if(!b)return;
 const k=b.dataset.key;
 if(k==="clear")code=code.slice(0,-1);
 else if(k==="enter"){check();return}
 else if(code.length<4)code+=k;
 dots();if(code.length===4)setTimeout(check,250);
};
function check(){
 if(code==="1234"){ $("error").textContent="잠금 해제";setTimeout(()=>go("secret"),300)}
 else{$("error").textContent="암호가 올바르지 않습니다.";code="";setTimeout(dots,500);setTimeout(()=>$("error").textContent="",1800)}
}

$("answer").onclick=()=>{
 go("incall");secs=0;clearInterval(timer);
 timer=setInterval(()=>{secs++;$("duration").textContent=String(Math.floor(secs/60)).padStart(2,"0")+":"+String(secs%60).padStart(2,"0")},1000);
};
function endCall(){clearInterval(timer);go("home")}
$("decline").onclick=endCall;$("end").onclick=endCall;

const photos=[
"https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=600",
"https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=600",
"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=600",
"https://images.unsplash.com/photo-1490750967868-88aa4486c946?w=600"
];
function addPhoto(src){
 const b=document.createElement("button");b.className="photo";
 const img=document.createElement("img");img.src=src;img.alt="사진";b.appendChild(img);
 b.onclick=()=>{
   const v=document.createElement("div");
   v.style.cssText="position:absolute;inset:0;z-index:20;background:#000;display:flex;align-items:center;justify-content:center;flex-direction:column";
   const big=document.createElement("img");big.src=src;big.style.cssText="width:100%;max-height:75%;object-fit:contain";
   const close=document.createElement("button");close.textContent="닫기 ✕";close.style.cssText="padding:12px 22px;margin-top:20px;border:0;border-radius:20px";
   close.onclick=()=>v.remove();v.append(big,close);$("photos").appendChild(v);
 };
 $("photoGrid").appendChild(b);
}
photos.forEach(addPhoto);
$("upload").onchange=e=>{
 Array.from(e.target.files).forEach(file=>{
   const r=new FileReader();r.onload=()=>addPhoto(r.result);r.readAsDataURL(file);
 });
};
$("closePhotos").onclick=()=>go("home");
</script>
</body>
</html>
